PREFIX sekg: <https://w3id.org/sekg/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX meshv: <http://id.nlm.nih.gov/mesh/vocab#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT ?topicId ?meanHuman ?cohesionWP ?status WHERE {
 ?t a sekg:DiscoveredTopic; sekg:topicId ?topicId; sekg:hasHumanSummary ?hs;
 sekg:hasCohesionStatus ?status.
 ?hs sekg:meanHumanRating ?meanHuman.
 OPTIONAL { ?t sekg:hasCohesionAssessment ?ca.
 ?ca sekg:hasCohesionMeasurement ?cm.
 ?cm sekg:usesMetric ?metric; sekg:cohesionMean ?cohesionWP.
 ?metric sekg:metricCode "WP". }
 } ORDER BY DESC(?meanHuman) ?topicId