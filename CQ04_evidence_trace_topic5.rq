PREFIX sekg: <https://example.org/sekg/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX meshv: <http://id.nlm.nih.gov/mesh/vocab#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT ?topicId ?termLabel ?p ?q ?sourceFile ?sourceSHA ?locator WHERE {
 ?t a sekg:DiscoveredTopic; sekg:topicId ?topicId; sekg:hasStatisticalAssociation ?a.
 FILTER(?topicId = 5)
 ?a sekg:hasSourceTerm ?term; sekg:pValue ?p; sekg:qValue ?q;
 prov:wasDerivedFrom ?artifact; sekg:sourceRecordLocator ?locator.
 ?term sekg:sourceTermLabel ?termLabel.
 ?artifact sekg:artifactFilename ?sourceFile; sekg:artifactSHA256 ?sourceSHA.
 } ORDER BY ?q LIMIT 20