PREFIX sekg: <https://example.org/sekg/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX meshv: <http://id.nlm.nih.gov/mesh/vocab#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT (COUNT(DISTINCT ?candidate) AS ?pending) WHERE {
 ?candidate a sekg:OntologyReviewCandidate; sekg:reviewStatus ?status;
 sekg:automaticAdmission ?admission; sekg:supportedByEvidence ?e. 
    FILTER(
        STR(?status) = "pending_human_review"
        && LCASE(STR(?admission)) = "false"
    )
}