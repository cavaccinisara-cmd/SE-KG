PREFIX sekg: <https://w3id.org/sekg/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX meshv: <http://id.nlm.nih.gov/mesh/vocab#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT (COUNT(DISTINCT ?a) AS ?associations) (COUNT(DISTINCT ?t) AS ?topics) (COUNT(DISTINCT ?term) AS ?terms) WHERE {
 ?t sekg:hasStatisticalAssociation ?a. ?a sekg:hasSourceTerm ?term. }