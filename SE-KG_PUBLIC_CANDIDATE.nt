<https://w3id.org/sekg/resource/configuration/10405c6f55d40de2ed167b3954281be02472bbb875f19499802c3ad80fa546fa> <https://w3id.org/sekg/ontology/configurationJSON> "{\"step\": \"58D\", \"analysis\": \"within-topic MeSH semantic cohesion\", \"literature_basis\": {\"primary_method_reference\": \"Zhu S, Zeng J, Mamitsuka H. Enhancing MEDLINE document clustering by incorporating MeSH semantic similarity. Bioinformatics. 2009;25(15):1944-1951.\", \"supporting_reference\": \"Yu G. Using meshes for MeSH term enrichment and semantic analyses. Bioinformatics. 2018;34(21):3766-3767.\"}, \"node_similarity_methods\": [{\"name\": \"Wu-Palmer\", \"short_name\": \"WP\", \"family\": \"hierarchy_depth_based\", \"use_as_primary\": false}, {\"name\": \"Leacock-Chodorow\", \"short_name\": \"LC\", \"family\": \"path_based\", \"use_as_primary\": false}, {\"name\": \"Lin\", \"short_name\": \"LIN\", \"family\": \"information_content_based\", \"use_as_primary\": false}, {\"name\": \"Jiang-Conrath\", \"short_name\": \"JC\", \"family\": \"information_content_based\", \"use_as_primary\": false}], \"multi_tree_aggregation\": {\"method\": \"Average Maximum Match\", \"abbreviation\": \"AMM\", \"preserve_all_tree_numbers\": true, \"select_single_preferred_tree\": false}, \"cross_top_level_hierarchy\": {\"rule\": \"tree-node similarity is zero\", \"basis\": \"MeSH top-level hierarchies are treated as disconnected for node similarity.\"}, \"information_content\": {\"required_for\": [\"LIN\", \"JC\"], \"definition\": \"Corpus-based IC computed from MeSH term frequency including descendant occurrences.\", \"corpus_definition\": \"Frozen study corpus: 924 unique articles and their official MeSH descriptor annotations.\", \"corpus_articles\": 924, \"declared_study_adaptation\": true, \"external_reference_corpus_used\": false}, \"within_topic_computation\": {\"eligible_topic_requirement\": \"at least 2 FDR-significant MeSH concepts\", \"eligible_topics_expected\": 13, \"single_concept_topics_expected\": 2, \"zero_concept_topics_expected\": 4, \"single_or_zero_concept_score\": null, \"artificial_zero_assignment\": false, \"pairwise_concept_strategy\": \"Compute semantic similarity for every unordered pair of significant MeSH concepts within each topic.\", \"topic_summary_statistics\": [\"number_of_concept_pairs\", \"mean_similarity\", \"median_similarity\", \"standard_deviation\", \"minimum\", \"maximum\"]}, \"robustness_policy\": {\"all_four_methods_reported\": true, \"choose_best_method_after_results\": false, \"single_primary_metric_preselected\": false, \"combine_methods_into_single_score\": false, \"method_rank_comparison_allowed\": true, \"jc_lambda_panel\": [1, 2, 3, 4, 5], \"select_best_jc_lambda_after_results\": false}, \"acceptance_threshold\": null, \"topic_acceptance_rejection\": false, \"human_validation_results_available\": false, \"human_validation_results_used\": false, \"created_at\": \"2026-08-14T17:16:22.234564\", \"protocol_amendment\": {\"amendment_step\": \"58D.1\", \"reason\": \"The original preregistration specified Jiang-Conrath but did not specify the lambda parameter used to transform JC distance into similarity.\", \"timing\": \"Amendment performed before any semantic similarity values were calculated.\", \"literature_basis\": \"Zhu, Zeng & Mamitsuka (2009) evaluated lambda values 1, 2, 3, 4, and 5 for JC.\", \"jc_lambda_values\": [1, 2, 3, 4, 5], \"single_lambda_preselected\": false, \"best_lambda_selected_posthoc\": false, \"all_lambda_results_reported\": true, \"created_at\": \"2026-08-14T17:20:28.892087\"}, \"virtual_category_root_amendment\": {\"step\": \"58D.2\", \"timing\": \"before any semantic similarity values were calculated\", \"structural_basis\": {\"different_mesh_category_letters\": \"different disconnected MeSH hierarchies\", \"same_category_different_explicit_tree_root\": \"shared virtual category root\", \"virtual_root_example\": \"C for Diseases\", \"virtual_root_depth\": 0}, \"information_content_basis\": {\"virtual_root_probability\": 1.0, \"virtual_root_information_content\": 0.0, \"interpretation\": \"The virtual category root represents the complete taxonomy used for intra-category IC comparison.\"}, \"cross_category_similarity\": 0.0, \"same_category_different_explicit_root_forced_zero\": false, \"semantic_similarity_values_observed\": false, \"topic_acceptance_rejection\": false, \"created_at\": \"2026-08-14T17:22:39.994602\"}}"^^<http://www.w3.org/2001/XMLSchema#string> .
